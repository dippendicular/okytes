{
  "manifest_version": 3,
  "key": "",
  "name": "Okytes Download Manager",
  "version": "0.1.0",
  "description": "Send downloads to Okytes with browser fallback and explicit site permissions.",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_permissions": [
    "cookies",
    "webRequest"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Okytes",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
