<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.okytes.daemon</string>
  <key>ProgramArguments</key><array>
    <string>/Users/YOUR_USER/.local/bin/okytes-daemon</string>
    <string>--data-dir</string><string>/Users/YOUR_USER/Library/Application Support/OkytesDaemon</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>3</integer>
  <key>ExitTimeOut</key><integer>90</integer>
  <key>Umask</key><integer>63</integer>
</dict></plist>
