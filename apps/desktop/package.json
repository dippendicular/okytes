{
  "name": "okytes-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "format": "prettier --write src scripts vite.config.ts quick.config.ts eslint.config.js package.json tsconfig.json index.html quick.html src-tauri/tauri.conf.json src-tauri/capabilities/main.json",
    "format:check": "prettier --check src scripts vite.config.ts quick.config.ts eslint.config.js package.json tsconfig.json index.html quick.html src-tauri/tauri.conf.json src-tauri/capabilities/main.json",
    "test:native": "node scripts/native-e2e.mjs",
    "test:quick": "node scripts/quick-e2e.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build && pnpm build:quick",
    "build:quick": "vite build --config quick.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "tauri": "tauri",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@tanstack/react-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
