{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Okytes",
  "version": "0.1.0",
  "identifier": "org.okytes.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "Okytes Download Manager",
        "width": 1200,
        "height": 780,
        "minWidth": 850,
        "minHeight": 560
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": { "installMode": "basicUi" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Okytes",
    "copyright": "Copyright © 2026 Okytes contributors",
    "shortDescription": "Fast, private and resilient download manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
