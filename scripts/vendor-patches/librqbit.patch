+//! Optional embedding validation before a peer's info dictionary is parsed.
+type Guard = fn(&[u8]) -> anyhow::Result<()>;
+static GUARD: std::sync::OnceLock<Guard> = std::sync::OnceLock::new();
+/// Install one process-wide envelope policy before opening application sessions.
+pub fn install(guard: Guard) { let _ = GUARD.set(guard); }
+pub(crate) fn check_info(info: &[u8]) -> anyhow::Result<()> {
+    if let Some(guard) = GUARD.get() {
+        let mut envelope = Vec::with_capacity(info.len() + 8);
+        envelope.extend_from_slice(b"d4:info");
+        envelope.extend_from_slice(info);
+        envelope.push(b'e');
+        guard(&envelope)?;
+    }
+    Ok(())
+}
