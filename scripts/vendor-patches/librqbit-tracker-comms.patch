+//! Bounded input preflight before deserializing untrusted bencode.
+pub(crate) fn valid(bytes:&[u8])->bool {
+    fn value(bytes:&[u8],at:&mut usize,depth:usize,nodes:&mut usize)->Option<()> {
+        if depth>16 || *nodes>=16384{return None;}*nodes+=1;
+        match *bytes.get(*at)? {
+            b'l'|b'd'=>{*at+=1;while *bytes.get(*at)?!=b'e'{value(bytes,at,depth+1,nodes)?;}*at+=1;}
+            b'i'=>{*at+=1;let start=*at;while *bytes.get(*at)?!=b'e'{*at+=1;if *at-start>21{return None;}}*at+=1;}
+            b'0'..=b'9'=>{let mut len=0usize;while bytes.get(*at).is_some_and(|b|b.is_ascii_digit()){len=len.checked_mul(10)?.checked_add((*bytes.get(*at)?-b'0') as usize)?;*at+=1;}if *bytes.get(*at)?!=b':'{return None;}*at=at.checked_add(1)?.checked_add(len)?;if *at>bytes.len(){return None;}}
+            _=>return None,
+        }Some(())
+    }
+    let mut at=0;value(bytes,&mut at,0,&mut 0).is_some()&&at==bytes.len()
+}
